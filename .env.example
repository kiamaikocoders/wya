# Supabase (client – use your project URL and anon key)
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_ALLOWED_REDIRECT_ORIGINS=https://yourapp.com,http://localhost:5173

# Edge Functions (set in Supabase Dashboard → Project Settings → Edge Functions or via CLI)
# ALLOWED_ORIGINS=https://yourapp.com,http://localhost:5173
# SUPABASE_ANON_KEY=your_anon_key  (for request-password-reset)
# REDIRECT_URL=https://yourapp.com/reset-password  (optional)
# MPESA_CALLBACK_SECRET=your_secret  (optional; add ?secret=... to M-Pesa callback URL)
