# Supabase (client – use your project URL and anon key)
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_ALLOWED_REDIRECT_ORIGINS=https://yourapp.com,http://localhost:5173

# Mapbox (for location search and maps)
# VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token
# Production (Vercel): Add this in Project Settings → Environment Variables

# Vercel AI Gateway (server-only — used by /api/ai on Vercel and by Vite dev proxy locally).
# Never use VITE_ prefix (that would expose the key in the browser bundle).
# Set VERCEL_AI_API_KEY in Vercel → Project → Settings → Environment Variables for production.
# VERCEL_AI_API_KEY=
# Optional: VERCEL_AI_GATEWAY_MODEL=google/gemini-2.0-flash-001
# If the UI is not served from the same origin as /api/ai, set the deployment origin only (no path):
# VITE_AI_PROXY_BASE_URL=https://your-app.vercel.app

# OneSignal Web Push (client – safe to expose App ID)
# VITE_ONESIGNAL_APP_ID=1a8bb6db-49a8-4a77-b9fc-649c17a8677e

# Edge Functions (set in Supabase Dashboard → Edge Function Secrets)
# Single secret for the whole project — all functions that validate CORS use this list:
# ALLOWED_ORIGINS=https://www.wya254.com,https://wya254.com,http://localhost:8080,http://localhost:5173
# Add Vercel preview URLs if you open the app from those hosts. Include admin + public routes:
# e.g. shared event media gallery (POST create-event-media-share, GET public-event-media-gallery) from the same SPA origins.
# SUPABASE_ANON_KEY=your_anon_key  (for request-password-reset)
# REDIRECT_URL=https://yourapp.com/reset-password  (optional)
# MPESA_CALLBACK_SECRET=your_secret  (optional; add ?secret=... to M-Pesa callback URL)
#
# OneSignal push delivery (send-push-notification Edge Function — server-only, never VITE_ prefix):
# ONESIGNAL_APP_ID=1a8bb6db-49a8-4a77-b9fc-649c17a8677e
# ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key
