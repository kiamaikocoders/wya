{
  "functions": {
    "api/ai.ts": {
      "maxDuration": 60
    },
    "api/r2-upload-url.ts": {
      "maxDuration": 30
    },
    "api/r2-upload.ts": {
      "maxDuration": 60
    },
    "api/r2-delete.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "admin.wya254.com" }],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/push/onesignal/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/push/onesignal/"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.wya254.com" }],
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/((?!admin(?:/|$)|api/|assets/).*)",
      "has": [{ "type": "host", "value": "admin.wya254.com" }],
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "www.wya254.com" }],
      "destination": "https://admin.wya254.com/admin",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "has": [{ "type": "host", "value": "www.wya254.com" }],
      "destination": "https://admin.wya254.com/admin/:path*",
      "permanent": false
    },
    {
      "source": "/admin-login",
      "has": [{ "type": "host", "value": "www.wya254.com" }],
      "destination": "https://admin.wya254.com/admin",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "wya254.com" }],
      "destination": "https://admin.wya254.com/admin",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "has": [{ "type": "host", "value": "wya254.com" }],
      "destination": "https://admin.wya254.com/admin/:path*",
      "permanent": false
    },
    {
      "source": "/admin-login",
      "has": [{ "type": "host", "value": "wya254.com" }],
      "destination": "https://admin.wya254.com/admin",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/app-version.json",
      "destination": "/api/app-version.json"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

